# videograph Environment Configuration

# Gemini API Key (required for transcription and knowledge extraction)
GEMINI_API_KEY=your_gemini_api_key_here

# Alternative standard Google API key variable
GOOGLE_API_KEY=your_google_api_key_here

# Optional: Default LLM model identifier
DEFAULT_LLM_MODEL=gemma-4-it

# Server Settings
HOST=0.0.0.0
PORT=8000
